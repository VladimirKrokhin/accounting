meta {
  name: Update User
  type: http
  seq: 3
}

post {
  url: {{base-url}}/api/v1/users/:user_id
  body: json
  auth: inherit
}

params:path {
  user_id: 1
}

body:json {
  {
    "email": "{{user_email}}",
    "full_name": "{{user_full_name}}",
    "password": "{{user_password}}"
  }
}

vars:pre-request {
  user_email: newedited@user.org
  user_full_name: New User
  user_password: 1234
}

settings {
  encodeUrl: true
  timeout: 0
}
