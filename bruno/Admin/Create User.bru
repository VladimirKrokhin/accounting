meta {
  name: Create User
  type: http
  seq: 1
}

post {
  url: {{base-url}}/api/v1/users
  body: json
  auth: inherit
}

params:query {
  : 
}

body:json {
  {
    "email": "{{user_email}}",
    "full_name": "{{user_full_name}}",
    "password": "{{user_password}}"
  }
}

vars:pre-request {
  user_email: new@user.org
  user_full_name: New User
  user_password: 1234
}

settings {
  encodeUrl: true
  timeout: 0
}
