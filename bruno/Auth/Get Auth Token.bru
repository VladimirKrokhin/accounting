meta {
  name: Get Auth Token
  type: http
  seq: 1
}

post {
  url: {{base-url}}/api/v1/auth
  body: json
  auth: inherit
}

body:json {
  {
    "email": "{{user_email}}",
    "password": "{{user_password}}"
  }
}

vars:pre-request {
  user_email: admin@test.com
  user_password: admin_password
}

settings {
  encodeUrl: true
  timeout: 0
}
